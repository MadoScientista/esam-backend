# Copiar a .env y completar con las credenciales reales.

# Formato: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=cloudinary://TU_API_KEY:TU_API_SECRET@TU_CLOUD_NAME

# Credenciales para la base de datos
DB_URL=jdbc:mysql://localhost:3306/NOMBRE_BASE_DE_DATOS?createDatabaseIfNotExist=true
DB_USERNAME=TU_USUARIO_MYSQL
DB_PASSWORD=TU_PASSWORD_MYSQL

# Seguridad JWT
JWT_SECRET=GENERA_UNO_NUEVO_CON_openssl_rand_base64_32
JWT_EXPIRATION=TIEMPO_EN_MILISEGUNDOS